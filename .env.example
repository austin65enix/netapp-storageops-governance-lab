# NetApp StorageOps Lab
# Public / synthetic configuration example.
#
# Do not commit real ONTAP credentials.

STORAGEOPS_PROJECT_DIR=/opt/netapp-storageops-lab

ONTAP_BASE_URL=http://127.0.0.1:8000
ONTAP_USERNAME=lab-user
ONTAP_PASSWORD=replace-me

STORAGEOPS_API_HOST=127.0.0.1
STORAGEOPS_API_PORT=8100

STORAGEOPS_EVIDENCE_DIR=/opt/netapp-storageops-lab/evidence/runtime
STORAGEOPS_SNAPSHOT_DIR=/opt/netapp-storageops-lab/snapshots/runs
